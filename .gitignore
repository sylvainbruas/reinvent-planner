# Python
# These are anchored with a leading slash so they only match Python build
# artefacts at the repo root. Unanchored (`lib/`, `build/`, `dist/`) they also
# match source directories nested anywhere in the tree — which silently
# excluded web/src/lib/.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

